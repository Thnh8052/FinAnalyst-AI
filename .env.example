# ==============================================================================
# FinAnalyst-AI - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# ==============================================================================

# DeepSeek Vision API (Default VLM Provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
VLM_PROVIDER=deepseek
VLM_MAX_TOKENS=8192

# Google Gemini API (Optional Fallback Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Parser Settings
FINANCIAL_PARSER_DPI=230
FINANCIAL_PARSER_OUT=output_financial_parser
